# ── FlowDeck — variables de entorno ──────────────────────────────────────────
# Todas son OPCIONALES. Sin ellas, la app funciona y crea los secretos sola en
# el primer arranque (los persiste en el volumen de datos).

# Puerto HTTP del servidor.
PORT=8080

# Carpeta de datos. Montá un volumen acá en Coolify para persistir la cuenta
# y las instancias entre deploys.
DATA_DIR=/data

# Secreto para firmar las sesiones (JWT). Si lo dejás vacío, se genera y guarda
# en el volumen. Definilo para rotar o centralizar. Ej: openssl rand -hex 32
JWT_SECRET=

# Secreto para cifrar las API keys de n8n en disco. Mismo criterio que arriba.
# OJO: si lo cambiás después de guardar instancias, tendrás que recargar sus keys.
APP_SECRET=

# (Opcional) Crear el admin automáticamente en el primer arranque, sin pasar por
# la pantalla de setup. Útil para deploys headless.
ADMIN_USERNAME=
ADMIN_PASSWORD=
